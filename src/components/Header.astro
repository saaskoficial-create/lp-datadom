---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { site } from "../data/content";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="#inicio" aria-label="DataDom, voltar ao início">
      <img src="/assets/logo-datadom.png" alt="" width="42" height="42" />
      <span>Data<span>Dom</span></span>
    </a>
    <nav aria-label="Navegação principal">
      <a href="#beneficios">Benefícios</a>
      <a href="#produto">Produto</a>
      <a href="#como-funciona">Como funciona</a>
      <a href="#duvidas">Dúvidas</a>
    </nav>
    <a
      class="button button-outline header-cta"
      href={site.officialUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Conhecer a DataDom <ArrowUpRight aria-hidden="true" size={17} />
    </a>
  </div>
</header>

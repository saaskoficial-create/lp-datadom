---
import ArrowRight from "@lucide/astro/icons/arrow-right";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { site } from "../data/content";
---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">
        Transforme os dados do Domínio em uma <em
          >visão clara da sua carteira.</em
        >
      </h1>
      <p>
        O DataDom importa os dados que seu escritório já produz e organiza
        informações financeiras e indicadores em dashboards para acompanhar.
      </p>
      <div class="hero-actions">
        <a
          class="button button-primary"
          href={site.officialUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Conhecer o DataDom <ArrowUpRight aria-hidden="true" size={18} />
        </a>
        <a class="button button-outline" href="#como-funciona">
          Ver como funciona <ArrowRight aria-hidden="true" size={18} />
        </a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-product">
        <span class="hero-product-label"
          >DataDom <span>· Visão financeira</span></span
        >
        <img
          src="/assets/visao-financeira.webp"
          alt="Exemplo ilustrativo da visão financeira do DataDom"
          width="1334"
          height="572"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <small class="hero-demo-note"
        >Exemplo da interface com dados demonstrativos.</small
      >
    </div>
  </div>
  <div class="container journey-line" aria-label="Dos dados à visão">
    <span>Dados no Domínio</span><span>Importação automática</span><span
      >Visão da carteira</span
    >
  </div>
</section>

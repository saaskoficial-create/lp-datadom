---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { site } from "../data/content";
---

<footer class="footer">
  <div class="container footer-inner">
    <a class="brand" href="#inicio" aria-label="DataDom, voltar ao início">
      <img
        src="/assets/logo-datadom-96.webp"
        alt=""
        width="42"
        height="39"
        loading="lazy"
        decoding="async"
      />
      <span>Data<span>Dom</span></span>
    </a>
    <p>Inteligência de dados para escritórios contábeis que usam Domínio.</p>
    <a href={site.officialUrl} target="_blank" rel="noopener noreferrer"
      >datadom.com.br <ArrowUpRight aria-hidden="true" size={15} /></a
    >
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getFullYear()} DataDom</span>
    <span
      >DataDom é uma plataforma independente. Domínio é marca de seu respectivo
      titular.</span
    >
  </div>
</footer>

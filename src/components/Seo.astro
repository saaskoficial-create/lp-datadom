---
export interface Props {
  title: string;
  description: string;
  image: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, jsonLd = [] } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL?.trim()
  ? new URL(import.meta.env.PUBLIC_SITE_URL)
  : (Astro.site ?? new URL("https://datadom.com.br"));
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);
const schemas = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow, max-image-preview:large" />
<meta name="author" content="DataDom" />
<link rel="canonical" href={canonicalUrl.href} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:site_name" content="DataDom" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl.href} />
<meta property="og:image" content={imageUrl.href} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl.href} />
{
  schemas.map((schema) => (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replaceAll("<", "\\u003c")}
    />
  ))
}
